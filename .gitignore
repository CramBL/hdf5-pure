/target
.DS_Store
matlab_fixtures/
# `examples/libver_fixtures.rs` writes here when run (the CI examples job runs
# every example), and the fixtures it produces are regenerated rather than kept.
libver_fixtures/
.claude/
# Fixture-regen venv (developer tool; committed fixtures are self-contained)
tests/data/h5py/zfp/.venv/
tests/data/h5py/lzf/.venv/
# Local scratch dir for drafts and throwaway work
/tmp/
# Throwaway scratch probe tests (zz_ prefix), never committed
tests/zz_*

# A failing heapscope baseline check writes a DHAT profile into the process's
# cwd -- the package root under `cargo test` -- so the failure can be read
# rather than only counted (tests/allocation_baseline.rs).
heapscope-assert-*.json

# Stray build artifacts
*.rlib
*.rmeta

# The Python project under scripts/python: its environment, caches and bytecode.
scripts/python/.venv/
.ruff_cache/
.pytest_cache/
__pycache__/

# Vale: synced packages, pinned by URL in .vale.ini. The project style and
# vocabulary are committed.
.vale/styles/Slop/
.vale/styles/.vale-config/
